# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (Prisma — configurado na R2)
DATABASE_URL="postgresql://usuario:senha@ep-seu-endpoint.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Autenticação (R3)
# JWT_SECRET precisa ter ao menos 16 caracteres. Gere um seguro com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-de-32-mais-caracteres"
JWT_EXPIRES_IN="7d"

# CORS (origens permitidas, separadas por vírgula se mais de uma)
CORS_ORIGIN="http://localhost:5173"

# Upload local (Multer — configurado em R4/R6)
UPLOAD_DIR="uploads"

# Mercado Pago — credenciais de TESTE (sandbox).
# Gere em: Devsite -> Suas integrações -> sua aplicação -> Credenciais de teste.
# Public Key e Access Token de teste têm prefixo "TEST-". O ACCESS_TOKEN nunca vai ao frontend.
MP_ACCESS_TOKEN="TEST-xxxx"
MP_PUBLIC_KEY="TEST-xxxx"
# Segredo da assinatura do webhook (x-signature). Gere/copie em Suas integrações -> Webhooks.
MP_WEBHOOK_SECRET="xxxx"

# ==========================================================================
# SMTP — e-mail transacional (opcional em dev)
# Sem estas vars o servidor SOBE normalmente; o envio entra em "modo dev":
# apenas loga um aviso e NÃO envia (ver src/lib/email.ts).
# Para ATIVAR o envio real, preencha as 5 vars (HOST/PORT/USER/PASS/FROM).
#
# Gmail: gere uma "Senha de app" (App Password) em
#   https://myaccount.google.com/apppasswords  (requer verificação em 2 etapas)
#   e use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true.
# Porta 587 -> SMTP_SECURE=false (STARTTLS). Porta 465 -> SMTP_SECURE=true.
# ==========================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app-de-16-digitos"
SMTP_FROM="3DCommerce <seu-email@gmail.com>"
SMTP_SECURE=true

# Base do frontend, usada para montar links de reset/verificação nos e-mails.
APP_URL="http://localhost:5173"
