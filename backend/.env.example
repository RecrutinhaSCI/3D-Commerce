# =============================================================================
# BACKEND — copie para .env (local) ou cadastre no Render (Web Service do
# backend → Environment). No Neon, DATABASE_URL do Render = URL com pooler;
# migrations/seed da sua máquina = URL direta (sem -pooler).
# Passo a passo de onde tirar cada valor: CONFIGURAR-CLIENTE.md (raiz).
# Depois de preencher, rode:  npm run check:config
# =============================================================================

# Servidor — em produção NODE_ENV=production (exige assinatura no webhook do MP)
PORT=3333
NODE_ENV=development

# Banco de dados (Neon/PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@ep-seu-endpoint.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Autenticação — JWT_SECRET com ao menos 16 caracteres. Gere um seguro com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-de-32-mais-caracteres"
JWT_EXPIRES_IN="7d"

# CORS — origens FIXAS permitidas (CSV separado por vírgula, sem barra final).
# `CORS_ORIGINS` (plural) é o nome preferido; `CORS_ORIGIN` fica só por compat.
# Ex.: "http://localhost:5173,https://3dcommerce.com.br"
# Produção: só o(s) domínio(s) real(is) da loja, ex.: "https://www.3dcommerce.com.br,https://3dcommerce.com.br"
CORS_ORIGINS="http://localhost:5173"
# Legado (só se CORS_ORIGINS estiver vazio):
# CORS_ORIGIN="http://localhost:5173"
# Regex OPCIONAL para autorizar previews da Vercel. Em produção, sem esta
# variável, o backend já autoriza automaticamente URLs do padrão
# https://3d-commerce-<hash>-recrutinha-sci-s-projects.vercel.app
# NUNCA use algo como ".*\.vercel\.app$" — isso abriria o backend para
# qualquer projeto Vercel de qualquer conta.
# VERCEL_PREVIEW_REGEX="^https://3d-commerce-[a-z0-9-]+-recrutinha-sci-s-projects\\.vercel\\.app$"

# Base do frontend, usada para montar links de reset/verificação nos e-mails.
# Produção: o domínio principal da loja, sem barra no fim.
APP_URL="http://localhost:5173"

# Cron diário (GitHub Actions, .github/workflows/expire-orders.yml): reconcilia
# pagamentos do Mercado Pago e cancela pedidos não pagos (48h; boleto 96h),
# devolvendo estoque/cupom. O workflow envia "Authorization: Bearer <CRON_SECRET>"
# — use o MESMO valor no secret CRON_SECRET do GitHub. Sem ele a rota fica
# desligada (503). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Uploads (imagens de produto, banners, logo, depoimentos, arquivos de orçamento)
# Produção: crie um Blob Store na Vercel (Storage → Create → Blob) e copie o
# BLOB_READ_WRITE_TOKEN para o Render (lá ele não é injetado sozinho).
# Sem ele: em desenvolvimento os uploads vão para UPLOAD_DIR no disco; em
# produção o upload é recusado (o disco do Render é efêmero).
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="uploads"

# -----------------------------------------------------------------------------
# Admin inicial — lido só pelo seed (npm run prisma:seed).
# ADMIN_PASSWORD só é usada para CRIAR o admin (em produção é obrigatória, mín. 8).
# Se o admin já existe, o seed nunca altera a senha dele — nem com esta variável.
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@3dcommerce.com"
ADMIN_NAME="3DCommerce Admin"
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Mercado Pago — conta do CLIENTE (Suas integrações -> sua aplicação).
# Sandbox: "Credenciais de teste". Produção: "Credenciais de produção" (APP_USR-...).
# O ACCESS_TOKEN nunca vai ao frontend (lá só VITE_MP_PUBLIC_KEY).
# Os valores de exemplo abaixo são recusados no boot de propósito.
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN="TEST-xxxx"
# Segredo da assinatura do webhook (x-signature): Suas integrações -> Webhooks.
# URL a cadastrar lá: https://<backend>/api/payments/webhook  (evento: Order)
MP_WEBHOOK_SECRET="xxxx"
# Opcional, só referência (o backend não usa).
MP_PUBLIC_KEY=""

# -----------------------------------------------------------------------------
# E-mail transacional (cadastro, pedido criado, pagamento aprovado, envio, senha).
# Vazio = "modo dev": o servidor sobe, só loga e NÃO envia.
#
# Opção 1 (em uso): SMTP do Google Workspace — preencha HOST/PORT/USER/PASS/FROM.
#   Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#   (requer verificação em 2 etapas) e use smtp.gmail.com, porta 465, SECURE=true.
#   ATENÇÃO: o Render Free bloqueia as portas SMTP (25/465/587) — exige plano pago.
# Opção 2: Brevo pela API HTTP — preencha BREVO_API_KEY e SMTP_FROM (remetente
#   verificado no Brevo). Tem prioridade sobre o SMTP e funciona no Render Free.
# Porta 587 -> SMTP_SECURE=false (STARTTLS). Porta 465 -> SMTP_SECURE=true.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_SECURE=true
BREVO_API_KEY=""

# -----------------------------------------------------------------------------
# Melhor Envio — SÓ cotação de frete (Correios PAC e Sedex). Tudo opcional:
# sem MELHOR_ENVIO_TOKEN o frete fica na tabela fixa (PAC R$ 24,90 / Sedex
# R$ 42,90). LIGADO e com falha (timeout, token, produto sem medidas...), o
# checkout oferece só a retirada — nunca cai na tabela fixa em silêncio.
# Valor inválido aqui NÃO derruba o servidor: desliga a cotação e aparece como
# aviso no boot e em `npm run check:config`.
# Token: painel do Melhor Envio → Gerenciar → Tokens (permissão de cotação).
# NUNCA vai ao frontend. Retirada na loja não depende disto.
# -----------------------------------------------------------------------------
MELHOR_ENVIO_TOKEN=""
# Sandbox (testes) ou produção: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"
# Exigido pela API: nome do app + e-mail de contato da loja.
MELHOR_ENVIO_USER_AGENT="3DCommerce (contato@sualoja.com.br)"
# Tempo máximo da cotação em ms, de 1000 a 30000 (fora disso usa 8000).
# Estourou = só retirada naquele momento, com "Tentar novamente".
MELHOR_ENVIO_TIMEOUT_MS=8000
# CEP de onde sai a mercadoria (8 dígitos).
SHIPPING_ORIGIN_CEP=""

# --- OAuth do aplicativo Melhor Envio (opcional; substitui o token manual) ---
# Cadastre o app em Melhor Envio → Integrações → Área Dev (sandbox e produção
# são cadastros SEPARADOS). O admin conecta em /admin/configuracoes; os tokens
# ficam CIFRADOS no banco e são renovados sozinhos (cron diário). Enquanto o
# OAuth não estiver conectado, vale o MELHOR_ENVIO_TOKEN acima.
# O host (sandbox/produção) é o mesmo de MELHOR_ENVIO_BASE_URL.
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
# IDÊNTICA à cadastrada no app (HTTPS). Produção:
#   https://threed-commerce-backend.onrender.com/api/integrations/melhor-envio/callback
MELHOR_ENVIO_REDIRECT_URI=""
# 32 bytes aleatórios (cifra os tokens no banco). Trocar = reconectar o OAuth.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=""

# ============================================================
# Pix Banco Inter / mock (R19) — módulo backend/src/modules/pix-inter
# DESLIGADO (sem rotas). A integração de pagamento em uso é o Mercado Pago.
# Nada abaixo é necessário para o deploy; só se o módulo for reativado.
# ============================================================
# PAYMENT_PROVIDER=mock
# Validade da cobrança Pix, em minutos.
# PAYMENT_PIX_EXPIRATION_MINUTES=30
# Secret HMAC dos webhooks do provider MOCK (mín. 16 chars).
# Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PAYMENT_WEBHOOK_SECRET="troque-por-um-secret-longo-e-aleatorio"

# ------------------------------------------------------------
# Banco Inter (FUTURO — nenhuma destas é usada ainda).
# NUNCA versionar valores reais nem os arquivos de certificado.
# Os certificados (.crt/.key) devem ficar FORA do repositório.
# ------------------------------------------------------------
# INTER_CLIENT_ID=""
# INTER_CLIENT_SECRET=""
# INTER_CERT_PATH="/caminho/seguro/fora/do/repo/inter.crt"
# INTER_KEY_PATH="/caminho/seguro/fora/do/repo/inter.key"
# INTER_PIX_KEY="sua-chave-pix-cadastrada-no-inter"
# INTER_WEBHOOK_SECRET=""
# INTER_BASE_URL="https://cdpj.partners.bancointer.com.br"

# true (padrão): checkout legado; simulações somente admin Sandbox.
MELHOR_ENVIO_HOMOLOGATION_ONLY=true
