// 3D Commerce — schema do banco
// Convenções:
//   - Models em PascalCase, campos em camelCase.
//   - Tabelas mapeadas para snake_case via @@map (e colunas-chave via @map).
//   - Valores monetários em Decimal(12, 2) para evitar float drift.
//   - Snapshots (cliente/endereço/produto em pedido) preservam histórico mesmo
//     se o registro de origem for editado ou removido depois.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Enums
// =========================================================================

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

/// Modalidade de entrega escolhida no checkout (valor calculado no backend).
enum ShippingMethod {
  PAC
  SEDEX
  PICKUP
}

enum ProductPurchaseMode {
  DIRECT
  QUOTE
  BOTH
}

enum QuoteStatus {
  RECEIVED
  ANALYZING
  WAITING_CUSTOMER
  APPROVED
  REJECTED
  CONVERTED_TO_ORDER
}

enum ContactMessageStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

enum PaymentProvider {
  MOCK
  INTER
}

// Status da COBRANÇA (Pix) — separado do PaymentStatus do pedido.
// APPROVED na cobrança ⇒ paymentStatus PAID no pedido.
enum PixChargeStatus {
  PENDING
  APPROVED
  EXPIRED
  CANCELED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ScriptCategory {
  COUPON
  POST_SALE
  QUOTE_RECOVERY
  LAUNCH
  SEASONAL_OFFER
  FREE_SHIPPING
  FEATURED_PRODUCT
  RETURNING_CUSTOMER
}

// =========================================================================
// Usuários e endereços
// =========================================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  role         UserRole @default(CUSTOMER)
  active       Boolean  @default(true)

  // Verificação de e-mail e recuperação de senha (F2).
  // Tokens NUNCA são guardados em texto — só o hash SHA-256 do token plano.
  emailVerified          Boolean   @default(false) @map("email_verified")
  emailVerifyTokenHash   String?   @map("email_verify_token_hash")
  emailVerifyExpiresAt   DateTime? @map("email_verify_expires_at")
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  // LGPD: quando o cliente aceitou a Política de Privacidade e qual versão.
  privacyConsentAt     DateTime? @map("privacy_consent_at")
  privacyPolicyVersion String?   @map("privacy_policy_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses Address[]
  cart      Cart?
  orders    Order[]
  quotes    Quote[]

  stockMovements StockMovement[]

  @@index([role])
  @@map("users")
}

model Address {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  label         String?
  recipientName String   @map("recipient_name")
  phone         String
  zipCode       String   @map("zip_code")
  street        String
  number        String
  complement    String?
  district      String
  city          String
  state         String
  country       String   @default("Brasil")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// =========================================================================
// Catálogo
// =========================================================================

model Category {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  active              Boolean  @default(true)
  isSeasonal          Boolean  @default(false) @map("is_seasonal")
  seasonalTitle       String?  @map("seasonal_title")
  seasonalDescription String?  @map("seasonal_description")
  seasonalBannerImage String?  @map("seasonal_banner_image")
  /// Imagem do card na Home (URL pública do Vercel Blob).
  imageUrl            String?  @map("image_url")
  /// Flags de exibição independentes de `active` (que tira a categoria do ar).
  showInMenu          Boolean  @default(true) @map("show_in_menu")
  showInHome          Boolean  @default(true) @map("show_in_home")
  /// Cores do banner sazonal (HEX #RRGGBB). null = visual padrão
  /// (#059669 → #0F1115, texto #FAFAF7).
  seasonalColorFrom   String?  @map("seasonal_color_from")
  seasonalColorTo     String?  @map("seasonal_color_to")
  seasonalTextColor   String?  @map("seasonal_text_color")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id               String              @id @default(cuid())
  categoryId       String              @map("category_id")
  name             String
  slug             String              @unique
  shortDescription String?             @map("short_description")
  description      String?
  price            Decimal             @db.Decimal(12, 2)
  promotionalPrice Decimal?            @map("promotional_price") @db.Decimal(12, 2)
  sku              String?             @unique
  /// EAN/GTIN ou código de barras próprio (leitor USB no PDV). Nunca inventado:
  /// fica nulo até o admin informar.
  barcode          String?             @unique
  /// Fonte ÚNICA de verdade do estoque (loja + PDV). Só o `stock.service` altera
  /// este campo, sempre registrando uma StockMovement na mesma transação.
  stock            Int                 @default(0)
  active           Boolean             @default(true)
  featured         Boolean             @default(false)
  // Dimensões e atributos físicos
  weight           Decimal?            @db.Decimal(10, 3) // kg
  width            Decimal?            @db.Decimal(10, 2) // cm
  height           Decimal?            @db.Decimal(10, 2) // cm
  depth            Decimal?            @db.Decimal(10, 2) // cm
  // R19-B — Marca (fabricante) SEPARADA de material. Ambas são texto livre e
  // independentes. Nenhum código deve derivar uma da outra.
  brand            String?
  material         String?
  color            String?
  printTime        String?             @map("print_time")
  purchaseMode     ProductPurchaseMode @default(DIRECT) @map("purchase_mode")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  // R19-E — Timestamp específico de estoque. Só é tocado quando `stock` muda de
  // fato (edição manual OU import Excel com valor diferente do atual). Nulo
  // significa "sem histórico" — inclusive para os produtos que já existiam
  // antes desta migration; NÃO backfillamos com data artificial.
  stockUpdatedAt   DateTime?           @map("stock_updated_at")

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([active])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  position  Int      @default(0)
  // R20 — permite GIF/MP4 na galeria.
  // "image" cobre JPG/PNG/WEBP/GIF; "video" cobre MP4. Produtos antigos
  // (sem valor no banco) usam o default "image" via migration.
  mediaType String   @default("image") @map("media_type")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// =========================================================================
// Carrinho
// =========================================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // Evita o mesmo produto duplicado no mesmo carrinho.
  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// =========================================================================
// Pedidos
// =========================================================================

model Order {
  id                   String              @id @default(cuid())
  userId               String?             @map("user_id")
  // Snapshot do cliente — preserva histórico mesmo se o User mudar.
  customerName         String              @map("customer_name")
  customerEmail        String              @map("customer_email")
  customerPhone        String              @map("customer_phone")
  // CPF do comprador (só dígitos) — exigido por Pix/boleto e base para NF-e.
  customerCpf          String?             @map("customer_cpf")
  // Snapshot do endereço (JSON). Estrutura:
  // { recipientName, zipCode, street, number, complement?, district, city, state, country }
  addressSnapshot      Json                @map("address_snapshot")
  subtotal             Decimal             @db.Decimal(12, 2)
  shippingValue        Decimal             @default(0) @map("shipping_value") @db.Decimal(12, 2)
  // Modalidade de entrega. Null = pedidos anteriores à regra de frete no backend.
  shippingMethod       ShippingMethod?     @map("shipping_method")
  // Detalhes da cotação usada no pedido (null em pedidos antigos). O valor
  // financeiro definitivo continua sendo `shippingValue`.
  shippingServiceId    Int?                @map("shipping_service_id") // 1 = PAC, 2 = Sedex (Melhor Envio)
  shippingServiceName  String?             @map("shipping_service_name")
  shippingCarrier      String?             @map("shipping_carrier")
  shippingDeadlineDays Int?                @map("shipping_deadline_days") // prazo do serviço de entrega
  shippingQuoteSource  String?             @map("shipping_quote_source") // melhor_envio | fixed | store
  discountValue        Decimal             @default(0) @map("discount_value") @db.Decimal(12, 2)
  // Desconto da FORMA de pagamento (ex.: % no Pix), já abatido de `total`.
  // Ao trocar de método, o total bruto é `total + paymentDiscount`.
  paymentDiscount      Decimal             @default(0) @map("payment_discount") @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)
  status               OrderStatus         @default(PENDING)
  paymentMethod        PaymentMethod       @map("payment_method")
  paymentStatus        PaymentStatus       @default(PENDING) @map("payment_status")
  // Mercado Pago — id da ORDER do MP (Orders API, ULID), preenchido ao criar/
  // confirmar. É o `{id}` de GET /v1/orders/{id} e o `data.id` do webhook.
  // (Nome mantido por compatibilidade; desde a T10 guarda o id da Order, não
  // mais o id do payment da Payments API.)
  mpPaymentId          String?             @map("mp_payment_id")
  // Nossa referência (id do pedido) enviada ao MP; reconcilia via webhook.
  externalReference    String?             @map("external_reference")
  // Idempotência da baixa de estoque: vira true quando o estoque é decrementado
  // (no pagamento PAID). Um guard atômico sobre este campo garante que a baixa
  // ocorra UMA vez por pedido, mesmo com webhook duplicado ou corrida entre
  // webhook e polling. A reposição (cancelamento/estorno) só age se true.
  stockApplied         Boolean             @default(false) @map("stock_applied")
  notes                String?
  // Código de rastreio da transportadora (Correios/Total Express). Consultado
  // na API SeuRastreio pelo frontend. Preenchido pelo admin quando o pedido é enviado.
  trackingCode         String?             @map("tracking_code")
  // Cupom aplicado — snapshot preserva o histórico mesmo que o cupom mude/some.
  // `discountValue` acima guarda o valor real descontado em R$.
  couponId             String?             @map("coupon_id")
  couponCode           String?             @map("coupon_code")
  couponDiscountType   CouponDiscountType? @map("coupon_discount_type")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon         Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  shipmentLabels ShipmentLabel[]
  stockMovements StockMovement[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([mpPaymentId])
  @@index([createdAt])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  // productId opcional — produto pode ser removido depois sem perder o pedido.
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  productSku  String?  @map("product_sku")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// =========================================================================
// Movimentações de estoque (livro-razão, só inclusão)
// =========================================================================

enum StockMovementType {
  ECOMMERCE_SALE
  POS_SALE
  INTERNAL_USE
  MANUAL_ADJUSTMENT
  RETURN
  CANCELLATION
  CORRECTION
  IMPORT
}

enum StockMovementSource {
  ECOMMERCE
  POS
  ADMIN
  IMPORT
}

/// Registro imutável de cada alteração de `Product.stock`, gravado na MESMA
/// transação da alteração. `productId` não tem FK de propósito: produtos têm
/// exclusão física e o histórico precisa sobreviver a ela (nome/SKU em snapshot).
model StockMovement {
  id             String              @id @default(cuid())
  /// Ordem global de gravação. O fechamento de caixa delimita sua janela por
  /// `seq`, e não por horário (ver cash session).
  seq            Int                 @unique @default(autoincrement())
  productId      String              @map("product_id")
  productName    String              @map("product_name")
  productSku     String?             @map("product_sku")
  type           StockMovementType
  source         StockMovementSource
  quantityBefore Int                 @map("quantity_before")
  /// Negativo = saída, positivo = entrada.
  quantityDelta  Int                 @map("quantity_delta")
  quantityAfter  Int                 @map("quantity_after")
  /// Responsável. Nulo = automático (webhook/expiração do e-commerce).
  userId         String?             @map("user_id")
  userName       String?             @map("user_name")
  note           String?
  orderId        String?             @map("order_id")
  /// Texto curto da referência exibida no relatório (ex.: "PDV-104").
  referenceLabel String?             @map("reference_label")
  /// Evita registrar duas vezes a mesma ação do operador (duplo clique/retry).
  idempotencyKey String?             @unique @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, seq])
  @@index([type])
  @@index([createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// =========================================================================
// Pagamentos (R19) — camada desacoplada por provider (MOCK hoje, INTER futuro)
// =========================================================================

model Payment {
  id           String          @id @default(cuid())
  orderId      String          @map("order_id")
  // Qual provider gerou esta cobrança — permite trocar de gateway sem migração.
  provider     PaymentProvider
  status       PixChargeStatus @default(PENDING)
  amount       Decimal         @db.Decimal(12, 2)
  // Identificador da cobrança no provider (txid do Pix). Único: nunca duas
  // cobranças com o mesmo txid, independente do provider.
  txid         String          @unique
  // Código Pix "copia e cola" (BR Code EMV). O QR Code é gerado a partir dele.
  pixCopyPaste String          @map("pix_copy_paste")
  // Conteúdo para renderizar o QR Code (igual ao copia-e-cola no Pix).
  qrCodeText   String          @map("qr_code_text")
  expiresAt    DateTime        @map("expires_at")
  paidAt       DateTime?       @map("paid_at")
  canceledAt   DateTime?       @map("canceled_at")
  // Payload bruto retornado pelo provider (para auditoria/debug).
  providerData Json?           @map("provider_data")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
  @@map("payments")
}

// Log imutável de eventos de pagamento (webhooks, simulações, transições).
// A unique (provider, external_event_id) garante idempotência: o mesmo
// webhook reenviado não é processado duas vezes.
model PaymentEvent {
  id              String          @id @default(cuid())
  paymentId       String          @map("payment_id")
  provider        PaymentProvider
  // Id do evento no provider (ou gerado internamente para simulações).
  externalEventId String          @map("external_event_id")
  type            String // ex.: "pix.approved", "pix.expired", "pix.canceled"
  payload         Json
  createdAt       DateTime        @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

// =========================================================================
// Orçamentos personalizados (impressão 3D)
// =========================================================================

model Quote {
  id             String      @id @default(cuid())
  userId         String?     @map("user_id")
  customerName   String      @map("customer_name")
  customerEmail  String      @map("customer_email")
  customerPhone  String      @map("customer_phone")
  title          String
  description    String
  material       String?
  color          String?
  quantity       Int         @default(1)
  deadline       String?
  estimatedValue Decimal?    @map("estimated_value") @db.Decimal(12, 2)
  adminNotes     String?     @map("admin_notes")
  status         QuoteStatus @default(RECEIVED)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  files QuoteFile[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteFile {
  id           String   @id @default(cuid())
  quoteId      String   @map("quote_id")
  filename     String // nome no disco
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int // bytes
  url          String // URL pública servida pelo /uploads
  createdAt    DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_files")
}

// =========================================================================
// Configurações e conteúdo editável
// =========================================================================

model SiteSettings {
  // Constante: garantimos um único registro com id fixo "main".
  id                    String  @id @default("main")
  storeName             String  @map("store_name")
  whatsapp              String
  email                 String
  instagram             String?
  address               String
  cnpj                  String?
  logoUrl               String? @map("logo_url")
  heroTitle             String? @map("hero_title")
  heroSubtitle          String? @map("hero_subtitle")
  aboutTitle            String? @map("about_title")
  aboutText             String? @map("about_text")
  seoTitle              String? @map("seo_title")
  seoDescription        String? @map("seo_description")
  pixDiscountPercent    Decimal @default(5) @map("pix_discount_percent") @db.Decimal(5, 2)
  freeShippingThreshold Decimal @default(299) @map("free_shipping_threshold") @db.Decimal(12, 2)
  shippingNote          String? @map("shipping_note")
  // Carrossel do hero: segundos entre um banner e outro.
  heroIntervalSeconds   Int     @default(6) @map("hero_interval_seconds")

  // --- Conteúdos editáveis (R17) ---
  // Redes sociais
  instagramHandle String? @map("instagram_handle")
  youtubeUrl      String? @map("youtube_url")
  youtubeHandle   String? @map("youtube_handle")
  facebookUrl     String? @map("facebook_url")
  tiktokUrl       String? @map("tiktok_url")

  // Seção comunidade (Instagram)
  communityInstagramEnabled  Boolean @default(true) @map("community_instagram_enabled")
  communityInstagramTitle    String? @map("community_instagram_title")
  communityInstagramSubtitle String? @map("community_instagram_subtitle")
  instagramItemsJson         Json?   @map("instagram_items_json")
  /// Capas do Blog: { "<slug-do-post>": "<url no Vercel Blob>" }. Os posts
  /// continuam no código; só a imagem é gerenciada pelo admin.
  blogCoversJson             Json?   @map("blog_covers_json")
  /// Textos dos posts do Blog editados no admin: { "<slug>": { title?,
  /// category?, excerpt?, readTime?, content? } }. Campo ausente = padrão do código.
  blogContentJson            Json?   @map("blog_content_json")

  // Seção YouTube
  youtubeSectionEnabled  Boolean @default(true) @map("youtube_section_enabled")
  youtubeSectionTitle    String? @map("youtube_section_title")
  youtubeSectionSubtitle String? @map("youtube_section_subtitle")
  youtubeChannelUrl      String? @map("youtube_channel_url")
  youtubeChannelLabel    String? @map("youtube_channel_label")
  youtubeVideosJson      Json?   @map("youtube_videos_json")

  // Newsletter
  newsletterEnabled        Boolean @default(true) @map("newsletter_enabled")
  newsletterEyebrow        String? @map("newsletter_eyebrow")
  newsletterTitle          String? @map("newsletter_title")
  newsletterDescription    String? @map("newsletter_description")
  newsletterButtonText     String? @map("newsletter_button_text")
  newsletterPlaceholder    String? @map("newsletter_placeholder")
  newsletterSuccessMessage String? @map("newsletter_success_message")

  // Blocos de confiança
  trustBlockEnabled Boolean @default(true) @map("trust_block_enabled")
  trustItemsJson    Json?   @map("trust_items_json")

  // Footer
  footerDescription String? @map("footer_description")
  footerShowSocials Boolean @default(true) @map("footer_show_socials")

  /// Remetente das etiquetas do Melhor Envio (nome, documento, IE, endereço
  /// estruturado…). SÓ admin: nunca entra no DTO público de settings.
  shippingSenderJson Json? @map("shipping_sender_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum BannerSlot {
  HERO
  PROMO
}

model Banner {
  id             String     @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String?    @map("image_url")
  buttonText     String?    @map("button_text")
  buttonLink     String?    @map("button_link")
  active         Boolean    @default(true)
  position       Int        @default(0)
  slot           BannerSlot @default(HERO)
  // Selos flutuantes do HERO: { enabled, tag, title, info }. Null = sem selo.
  badgeLeftJson  Json?      @map("badge_left_json")
  badgeRightJson Json?      @map("badge_right_json")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([active])
  @@index([position])
  @@index([slot])
  @@map("banners")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  content   String
  rating    Int      @default(5)
  avatarUrl String?  @map("avatar_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("testimonials")
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// =========================================================================
// Cupons de desconto e scripts de mensagem (WhatsApp manual)
// =========================================================================

model Coupon {
  id                    String             @id @default(cuid())
  code                  String             @unique
  name                  String
  description           String?
  discountType          CouponDiscountType @map("discount_type")
  // Valor do desconto: % (0–100) para PERCENTAGE, valor em R$ para FIXED_AMOUNT,
  // ignorado (0) para FREE_SHIPPING.
  discountValue         Decimal            @default(0) @map("discount_value") @db.Decimal(12, 2)
  minOrderValue         Decimal?           @map("min_order_value") @db.Decimal(12, 2)
  // Teto de desconto (usado principalmente para PERCENTAGE).
  maxDiscountValue      Decimal?           @map("max_discount_value") @db.Decimal(12, 2)
  startsAt              DateTime?          @map("starts_at")
  expiresAt             DateTime?          @map("expires_at")
  usageLimit            Int?               @map("usage_limit")
  usageCount            Int                @default(0) @map("usage_count")
  usageLimitPerCustomer Int?               @map("usage_limit_per_customer")
  isActive              Boolean            @default(true) @map("is_active")
  isSeasonal            Boolean            @default(false) @map("is_seasonal")
  seasonalName          String?            @map("seasonal_name")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  scripts CouponScript[]
  orders  Order[]

  @@index([isActive])
  @@index([code])
  @@map("coupons")
}

model CouponScript {
  id              String         @id @default(cuid())
  title           String
  description     String?
  messageTemplate String         @map("message_template")
  category        ScriptCategory @default(COUPON)
  linkedCouponId  String?        @map("linked_coupon_id")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Um script pode ter no máximo um cupom vinculado; o cupom pode ter vários scripts.
  // SetNull: remover o cupom não apaga o script, só desvincula.
  linkedCoupon Coupon? @relation(fields: [linkedCouponId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([linkedCouponId])
  @@index([isActive])
  @@map("coupon_scripts")
}

// =========================================================================
// Newsletter
// =========================================================================

/// Inscritos na newsletter (formulário da home). E-mail único; inscrever de
/// novo reativa (limpa unsubscribedAt).
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

// =========================================================================
// Integrações OAuth (Melhor Envio) — tokens SEMPRE cifrados (AES-256-GCM,
// chave em MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY). Nunca guardar token em claro.
// =========================================================================

/// Credencial OAuth de uma integração por ambiente (sandbox/production).
model IntegrationCredential {
  id                    String    @id @default(cuid())
  provider              String // "melhor_envio"
  environment           String // "sandbox" | "production"
  accessTokenEnc        String    @map("access_token_enc")
  refreshTokenEnc       String    @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime  @map("access_token_expires_at")
  // Estimada na emissão (o Melhor Envio informa 45 dias para o refresh token).
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  /// Scopes CONCEDIDOS (normalizados, separados por espaço).
  scope                 String?
  /// Origem da lista: response | token | requested (não confirmada) | null = conexão legada.
  scopeSource           String?   @map("scope_source")
  // Controle otimista: cada renovação grava version + 1.
  version               Int       @default(0)
  // Lease da renovação (impede dois processos renovando ao mesmo tempo).
  refreshLockUntil      DateTime? @map("refresh_lock_until")
  needsReconnect        Boolean   @default(false) @map("needs_reconnect")
  lastRefreshedAt       DateTime? @map("last_refreshed_at")
  // Código curto do último erro (ex.: "refresh_invalid") — nunca token/resposta.
  lastError             String?   @map("last_error")
  connectedByUserId     String?   @map("connected_by_user_id")
  connectedAt           DateTime  @default(now()) @map("connected_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([provider, environment])
  @@map("integration_credentials")
}

/// State do OAuth: só o HASH (sha256), uso único e expiração curta.
model OAuthState {
  id          String    @id @default(cuid())
  provider    String
  environment String
  stateHash   String    @unique @map("state_hash")
  userId      String    @map("user_id")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

// -----------------------------------------------------------------------------
// Etiquetas do Melhor Envio (postagem) — compra SEMPRE confirmada pelo admin.
// -----------------------------------------------------------------------------

/// Ausência de registro = "não iniciada".
enum ShipmentLabelStatus {
  PREPARED // frete no carrinho do Melhor Envio, preço consultado
  AWAITING_CONFIRMATION // aguardando o admin confirmar o preço (token com validade)
  PURCHASING // checkout em andamento (lease em lock_until)
  PURCHASED // paga no Melhor Envio
  GENERATING // geração solicitada
  LABEL_READY // etiqueta gerada (pode baixar/imprimir)
  POSTED // postada (status vindo do Melhor Envio)
  DELIVERED // entregue (status vindo do Melhor Envio)
  NEEDS_RECONCILIATION // resposta ambígua/timeout: consultar o Melhor Envio antes de qualquer ação
  ERROR // erro recuperável (detalhe em last_error_*)
  CANCELED
  CANCELING // cancelamento enviado ao Melhor Envio (lease em lock_until)
  DISCARDED // preparação NÃO paga descartada (provado no Melhor Envio); inativa
}

/// Modalidade fiscal do envio.
enum ShipmentFiscalMode {
  DECLARATION // declaração de conteúdo (sem NF-e)
  NFE // envio comercial com chave da NF-e
}

model ShipmentLabel {
  id            String              @id @default(cuid())
  orderId       String              @map("order_id")
  /// = orderId enquanto a etiqueta está ATIVA; null quando cancelada. O
  /// índice único garante UMA etiqueta ativa por pedido (NULLs não colidem).
  activeOrderId String?             @unique @map("active_order_id")
  /// "sandbox" | "production" — sandbox é SEMPRE etiqueta de teste.
  environment   String
  status        ShipmentLabelStatus @default(PREPARED)
  /// Controle otimista: toda transição grava version + 1 (compare-and-set).
  version       Int                 @default(0)
  /// Lease do checkout/geração: impede duas requisições comprando ao mesmo tempo.
  lockUntil     DateTime?           @map("lock_until")

  // Identificadores do Melhor Envio (nunca vindos do frontend).
  meOrderId    String? @unique @map("me_order_id") // UUID devolvido pelo carrinho
  meProtocol   String? @map("me_protocol")
  mePurchaseId String? @map("me_purchase_id")

  serviceId   Int     @map("service_id") // 1 = PAC, 2 = Sedex
  serviceName String? @map("service_name")
  carrier     String?

  // Fiscal: declaração de conteúdo OU NF-e (só a chave; não emitimos nota).
  fiscalMode ShipmentFiscalMode @map("fiscal_mode")
  nfeKey     String?            @map("nfe_key") // 44 dígitos

  /// Embalagem REAL usada: { weightKg, heightCm, widthCm, lengthCm, source }.
  packageJson   Json    @map("package_json")
  /// Valor declarado/segurado (soma dos itens).
  declaredValue Decimal @map("declared_value") @db.Decimal(12, 2)

  // Valores: o que o cliente pagou × o custo real da etiqueta.
  customerShippingValue Decimal  @map("customer_shipping_value") @db.Decimal(12, 2)
  quotedPrice           Decimal? @map("quoted_price") @db.Decimal(12, 2)
  paidPrice             Decimal? @map("paid_price") @db.Decimal(12, 2)
  /// sha256 do payload enviado ao carrinho (detecta mudança sem guardar dados pessoais).
  payloadHash           String?  @map("payload_hash")

  // Confirmação de compra: token só como HASH, preso ao preço exibido.
  confirmationHash      String?   @map("confirmation_hash")
  confirmationExpiresAt DateTime? @map("confirmation_expires_at")
  confirmationPrice     Decimal?  @map("confirmation_price") @db.Decimal(12, 2)

  trackingCode String? @map("tracking_code") // rastreio da transportadora
  selfTracking String? @map("self_tracking") // rastreio do próprio Melhor Envio

  preparedAt   DateTime? @map("prepared_at")
  purchasedAt  DateTime? @map("purchased_at")
  generatedAt  DateTime? @map("generated_at")
  postedAt     DateTime? @map("posted_at")
  deliveredAt  DateTime? @map("delivered_at")
  canceledAt   DateTime? @map("canceled_at")
  lastSyncedAt DateTime? @map("last_synced_at")
  /// Geração PEDIDA ao ME. `generatedAt` só é preenchido quando o ME CONFIRMA
  /// a etiqueta gerada (status/data) — o download depende disso.
  generationRequestedAt DateTime? @map("generation_requested_at")
  /// Motivo informado pelo admin no cancelamento/descarte (sanitizado).
  cancelReason String? @map("cancel_reason")

  // Último erro: código curto + mensagem amigável (nunca resposta bruta/token).
  lastErrorCode    String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")

  createdByUserId   String? @map("created_by_user_id")
  purchasedByUserId String? @map("purchased_by_user_id")
  canceledByUserId  String? @map("canceled_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order  Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events ShipmentLabelEvent[]

  @@index([orderId])
  @@index([status])
  @@map("shipment_labels")
}

/// Histórico só de inclusão (auditoria). Sem dados pessoais nem tokens.
model ShipmentLabelEvent {
  id          String               @id @default(cuid())
  labelId     String               @map("label_id")
  orderId     String               @map("order_id")
  type        String // ex.: prepared, confirmation_issued, purchase_started, purchased, reconciled, error
  fromStatus  ShipmentLabelStatus? @map("from_status")
  toStatus    ShipmentLabelStatus? @map("to_status")
  userId      String?              @map("user_id")
  detailsJson Json?                @map("details_json")
  createdAt   DateTime             @default(now()) @map("created_at")

  label ShipmentLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@index([labelId])
  @@index([orderId])
  @@map("shipment_label_events")
}
