# =============================================================================
# FRONTEND — variáveis da Vercel (Project Settings -> Environment Variables).
# Passo a passo de onde tirar cada valor: CONFIGURAR-CLIENTE.md
# =============================================================================

# URL base da API backend (em produção: domínio do projeto backend na Vercel, sem barra no fim)
VITE_API_URL=http://localhost:3333

# Domínio público da loja, sem barra no fim (ex.: https://www.3dcommerce.com.br).
# Usado para gerar sitemap.xml, robots.txt e og:image com URL absoluta no build.
VITE_SITE_URL=

# Google Analytics 4 (opcional) — ID da propriedade do cliente, ex.: G-XXXXXXXXXX.
# Vazio = sem analytics. Com ID, o banner de cookies passa a pedir consentimento
# e o script só carrega depois de "Aceitar todos" (LGPD).
VITE_GA_MEASUREMENT_ID=

# Mercado Pago — PUBLIC KEY da conta do cliente.
# Sandbox: credencial de teste. Produção: "Credenciais de produção" (prefixo APP_USR-).
# Só a public key vai ao frontend; o access token fica apenas no backend.
VITE_MP_PUBLIC_KEY=

# API de rastreio de encomendas (SeuRastreio)
# Gere sua chave gratuita no dashboard: https://seurastreio.com.br
# Formato: sr_live_xxxxxxxxxxxxxxxx
# ATENÇÃO: variável VITE_* vai para o bundle público — qualquer visitante consegue lê-la.
VITE_SEURASTREIO_API_KEY=
